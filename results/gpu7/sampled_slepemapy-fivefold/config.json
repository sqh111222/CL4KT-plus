{
  "data_name": "sampled_slepemapy",
  "data_path": "dataset/sampled_slepemapy/preprocessed_df.csv",
  "seed": 12405,
  "num_folds": 5,
  "validation_fraction": 0.1,
  "model": {
    "hidden_size": 64,
    "num_blocks": 2,
    "num_attn_heads": 8,
    "kq_same": true,
    "final_fc_dim": 512,
    "d_ff": 1024,
    "l2": 0.0,
    "dropout": 0.2,
    "reg_cl": 0.1,
    "mask_prob": 0.5,
    "crop_prob": 0.3,
    "permute_prob": 0.5,
    "replace_prob": 0.5,
    "negative_prob": 1.0,
    "temp": 0.05,
    "hard_negative_weight": 1.0
  },
  "train": {
    "seq_len": 100,
    "batch_size": 512,
    "eval_batch_size": 512,
    "num_epochs": 300,
    "patience": 10,
    "learning_rate": 0.001,
    "max_grad_norm": 2.0,
    "num_workers": 0,
    "cpu_threads": 4
  }
}
